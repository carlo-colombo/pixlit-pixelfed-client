<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Daytime window theme. Compose owns the in-app colors (see ui/theme/Theme.kt); this XML
         theme only has to match the window background so the frame before the first Compose pass
         does not flash. The matching dark override is values-night/themes.xml.

         Parent stays on the platform Material theme: `com.google.android.material` is not on the
         classpath (only Compose Material3 is), so `Theme.Material3.*` XML themes do not resolve,
         and the platform ships no `Theme.DeviceDefault.DayNight.NoActionBar`. -->
    <style name="Theme.PixelfedClient" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/background_light</item>
    </style>
</resources>
